<?xml version="1.0" encoding="utf-8"?>
<!--
    AndroidManifest.xml

    Application manifest for the SipSense Android app.
    Declares the application's activities and their configurations:

    - LoginActivity: The launcher activity (entry point of the app).
      Displayed when the user opens SipSense from the home screen.

    - RegisterActivity: The registration screen.
      Navigated to from LoginActivity when the user taps "Sign Up".

    Both activities use the SipSense custom theme (Theme.SipSense)
    which removes the default action bar and applies brand styling.

    @project SipSense - Smart Bottle Ecosystem
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@drawable/logo_sipsense_green"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo_sipsense_green"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.SipSense">

        <!--
            LoginActivity - Main entry point
            IntentFilter with MAIN action and LAUNCHER category marks
            this as the first screen shown when the app is launched.
        -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            RegisterActivity - User registration screen
            Not exported (only accessible within the app).
            Locked to portrait orientation for consistent form layout.
        -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!--
            MainActivity - Post-login main screen
            Hosts the bottom navigation bar with four top-level destinations:
            Dashboard, History, Devices, and Profile.
            Not exported (only accessible after successful authentication).
        -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

    </application>

</manifest>
