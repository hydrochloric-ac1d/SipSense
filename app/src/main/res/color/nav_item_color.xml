<?xml version="1.0" encoding="utf-8"?>
<!--
    nav_item_color.xml

    Color state list for the bottom navigation bar icon and text tinting.
    - Selected (checked) items use the primary teal brand color (#2BB5B2)
    - Unselected items use a neutral grey (#9E9E9E)

    Applied via app:itemIconTint and app:itemTextColor on BottomNavigationView.

    @project SipSense - Smart Bottle Ecosystem
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Active / selected tab: primary teal -->
    <item
        android:color="@color/teal_primary"
        android:state_checked="true" />

    <!-- Inactive / unselected tab: grey -->
    <item android:color="@color/nav_unselected" />

</selector>
