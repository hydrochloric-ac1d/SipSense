<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_notifications.xml

    Layout for the Notifications screen.
    Displays hydration reminders, hardware sensor alerts, and connectivity events
    retrieved in real-time from Firebase Realtime Database.

    Includes:
    - Screen header with title, unread count badge, and "Mark all read" action
    - Loading progress indicator
    - Empty state view when no notifications are present
    - RecyclerView for grouped notification cards

    @project SipSense - Smart Bottle Ecosystem
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_teal">

    <!-- ═══════════════════════════════════════════════════════════════
         HEADER ROW (Title, Unread Badge, Mark All Read)
         ═══════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layout_notifications_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="16dp"
        android:layout_marginHorizontal="24dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tv_notifications_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/notifications_title"
            android:textColor="@color/text_white"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Unread Count Pill Badge -->
        <TextView
            android:id="@+id/tv_unread_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_pill_unread"
            android:textColor="@color/text_white"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Mark All Read Action -->
        <TextView
            android:id="@+id/tv_mark_all_read"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="6dp"
            android:text="@string/notifications_mark_all_read"
            android:textColor="@color/text_white"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════════
         LOADING INDICATOR
         ═══════════════════════════════════════════════════════════════ -->
    <ProgressBar
        android:id="@+id/pb_notifications_loading"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:indeterminateTint="@color/text_white"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layout_notifications_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ═══════════════════════════════════════════════════════════════
         EMPTY STATE VIEW
         ═══════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/layout_empty_notifications"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginHorizontal="32dp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/layout_notifications_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:background="@drawable/bg_circle_light_teal">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_bell"
                app:tint="@color/teal_primary" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/notifications_empty_title"
            android:textColor="@color/text_white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/notifications_empty_subtitle"
            android:textColor="#C0E0E0"
            android:textSize="14sp" />

    </LinearLayout>

    <!-- ═══════════════════════════════════════════════════════════════
         RECYCLERVIEW FOR NOTIFICATIONS
         ═══════════════════════════════════════════════════════════════ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_notifications"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="80dp"
        app:layout_constraintTop_toBottomOf="@id/layout_notifications_header"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
