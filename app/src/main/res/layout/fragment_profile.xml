<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_profile.xml

    Single-card Profile Layout incorporating:
    - User Profile Image overlapping the top of the card
    - Full Name and Email
    - Daily Hydration Target with Slider
    - Account Preferences panel (Units, Notifications, Connected Apps, Password)
    - Log Out button

    @project SipSense - Smart Bottle Ecosystem
-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_gradient_teal">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="100dp">

        <!-- Main White Card Container -->
        <LinearLayout
            android:id="@+id/main_card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/spacing_lg"
            android:layout_marginEnd="@dimen/spacing_lg"
            android:layout_marginTop="60dp"
            android:layout_marginBottom="@dimen/spacing_xxl"
            android:background="@drawable/bg_card_rounded"
            android:elevation="8dp"
            android:orientation="vertical"
            android:paddingTop="70dp"
            android:paddingBottom="@dimen/spacing_xl"
            android:paddingStart="@dimen/spacing_xl"
            android:paddingEnd="@dimen/spacing_xl"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- User Name -->
            <TextView
                android:id="@+id/tv_profile_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textAlignment="center"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- User Email -->
            <TextView
                android:id="@+id/tv_profile_email"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:textAlignment="center"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/text_body"
                android:layout_marginBottom="@dimen/spacing_xxl" />

            <!-- Hydration Target Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_daily_target"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body"
                android:layout_marginBottom="@dimen/spacing_xs" />

            <!-- Hydration Slider -->
            <com.google.android.material.slider.Slider
                android:id="@+id/slider_hydration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:valueFrom="500.0"
                android:valueTo="5000.0"
                android:value="2500.0"
                android:stepSize="100.0"
                app:thumbColor="@color/teal_primary"
                app:trackColorActive="@color/teal_primary"
                app:trackColorInactive="@color/input_background"
                app:labelBehavior="floating" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/spacing_xxl">
                
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/droplet"
                    android:contentDescription="@null"
                    app:tint="@color/teal_primary"
                    android:layout_marginEnd="4dp" />

                <TextView
                    android:id="@+id/tv_target_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2500 ml"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tv_target_max"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="5000 ml"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <!-- Account Preferences Section -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title_account_prefs"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/text_body"
                android:layout_marginBottom="@dimen/spacing_sm" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/input_background" />

            <!-- Row: Units -->
            <LinearLayout
                android:id="@+id/row_units"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_target"
                    app:tint="@color/teal_primary"
                    android:layout_marginEnd="@dimen/spacing_md" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_units"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body" />

                <TextView
                    android:id="@+id/tv_unit_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ml"
                    android:textColor="@color/text_secondary"
                    android:textSize="@dimen/text_body" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/input_background" />

            <!-- Row: Notification Settings -->
            <LinearLayout
                android:id="@+id/row_notifications"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <!-- Bell icon for notification settings -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/teal_primary"
                    android:layout_marginEnd="@dimen/spacing_md" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_notification_settings"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body" />


            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/input_background" />

            <!-- Row: Connected Apps -->
            <LinearLayout
                android:id="@+id/row_connected_apps"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <!-- Reusing target icon as placeholder for link -->
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_target"
                    app:tint="@color/teal_primary"
                    android:layout_marginEnd="@dimen/spacing_md" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_connected_apps"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body" />


            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/input_background" />

            <!-- Row: Change Password -->
            <LinearLayout
                android:id="@+id/row_change_password"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_lock"
                    app:tint="@color/teal_primary"
                    android:layout_marginEnd="@dimen/spacing_md" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/label_change_password"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_body" />


            </LinearLayout>
            
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/input_background"
                android:layout_marginBottom="@dimen/spacing_xl" />

            <!-- Log Out Button -->
            <Button
                android:id="@+id/btn_logout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_button"
                android:layout_marginTop="@dimen/spacing_md"
                android:text="@string/btn_logout"
                android:textColor="@color/text_white"
                android:textSize="@dimen/text_heading"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:background="@drawable/bg_button_gradient"
                android:letterSpacing="0.02" />

        </LinearLayout>

        <!-- Overlapping Profile Picture -->
        <FrameLayout
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:background="@drawable/bg_circle_white"
            android:padding="6dp"
            android:elevation="10dp">
            
            <!-- White border effect via background padding -->
            <ImageView
                android:id="@+id/iv_profile_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/user_profile"
                android:contentDescription="@string/nav_profile"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_circle_white"
                android:clipToOutline="true"/>
        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
