<?xml version="1.0" encoding="utf-8"?>
<!--
    fragment_waterbottle.xml

    Bottle BLE Hardware & Navigation screen.
    Features:
    - Unified single card for bottle management and scanning
    - Active bottle connection overview with live telemetry (Water Level, Battery, Temp)
    - Equal sized telemetry tiles with icons beside titles
    - Offline / Connected status indicator
    - Bottle Scanner with Find Bottle / Disconnect toggle
    - Discovered Bottles list (automatically hidden when bottle is connected)
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:background="@drawable/bg_gradient_teal">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:paddingBottom="90dp">

        <!-- ── Title & Subtitle ── -->
        <TextView
            android:id="@+id/tv_waterbottle_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/waterbottle_title"
            android:textColor="@color/text_white"
            android:textSize="24sp"
            android:textStyle="bold"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tv_waterbottle_subtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/waterbottle_subtitle"
            android:textColor="#D0EFEF"
            android:textSize="13sp"
            app:layout_constraintTop_toBottomOf="@id/tv_waterbottle_header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ── Unified Main Bottle Card ── -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_bottle_main"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/card_background"
            app:layout_constraintTop_toBottomOf="@id/tv_waterbottle_subtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <!-- Header Row: Bottle Icon, Device Name, Connection Badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <FrameLayout
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_circle_light_teal">

                        <ImageView
                            android:id="@+id/iv_active_bottle_icon"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:layout_gravity="center"
                            android:src="@drawable/water_bottle"
                            app:tint="@color/teal_primary" />
                    </FrameLayout>

                    <TextView
                        android:id="@+id/tv_active_bottle_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:text="@string/label_device_name"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <!-- Connection Badge -->
                    <LinearLayout
                        android:id="@+id/layout_connection_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:background="@drawable/bg_device_badge"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp">

                        <View
                            android:id="@+id/v_connection_dot"
                            android:layout_width="8dp"
                            android:layout_height="8dp"
                            android:background="@drawable/bg_circle_inactive" />

                        <TextView
                            android:id="@+id/tv_connection_badge_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="@string/waterbottle_disconnected"
                            android:textColor="@color/text_secondary"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/input_background" />

                <!-- Telemetry Row (Equal card sizes, icons beside titles) -->
                <LinearLayout
                    android:id="@+id/layout_telemetry_metrics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:weightSum="3">

                    <!-- Water Level Tile -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginEnd="4dp"
                        android:minHeight="85dp"
                        android:background="@drawable/bg_metric_tile"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <!-- Icon Beside Title -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:id="@+id/iv_metric_water"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/droplet"
                                app:tint="@color/text_secondary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="@string/label_water_level"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                android:singleLine="true"
                                android:ellipsize="end" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_bottle_water_liters"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="--"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:singleLine="true" />

                        <TextView
                            android:id="@+id/tv_bottle_water_ml"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="--"
                            android:textColor="@color/text_hint"
                            android:textSize="10sp"
                            android:singleLine="true"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <!-- Battery Tile -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginHorizontal="2dp"
                        android:minHeight="85dp"
                        android:background="@drawable/bg_metric_tile"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <!-- Icon Beside Title -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:id="@+id/iv_metric_battery"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_battery"
                                app:tint="@color/text_secondary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="@string/label_battery"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                android:singleLine="true"
                                android:ellipsize="end" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_bottle_battery"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="--"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:singleLine="true" />

                        <TextView
                            android:id="@+id/tv_bottle_battery_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/ambient_temp_status_waiting"
                            android:textColor="@color/text_hint"
                            android:textSize="10sp"
                            android:singleLine="true"
                            android:ellipsize="end" />
                    </LinearLayout>

                    <!-- Ambient Temperature Tile -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:minHeight="85dp"
                        android:background="@drawable/bg_metric_tile"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <!-- Icon Beside Title -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <ImageView
                                android:id="@+id/iv_metric_temp"
                                android:layout_width="14dp"
                                android:layout_height="14dp"
                                android:src="@drawable/ic_temperature"
                                app:tint="@color/text_secondary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="@string/label_ambient_temp"
                                android:textColor="@color/text_secondary"
                                android:textSize="11sp"
                                android:singleLine="true"
                                android:ellipsize="end" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_bottle_ambient_temp"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:text="--"
                            android:textColor="@color/text_secondary"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            android:singleLine="true" />

                        <TextView
                            android:id="@+id/tv_bottle_temp_status"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/ambient_temp_status_waiting"
                            android:textColor="@color/text_hint"
                            android:textSize="10sp"
                            android:singleLine="true"
                            android:ellipsize="end" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="14dp"
                    android:background="@color/input_background" />

                <!-- Action Button Row: Find Bottle / Stop Scanning / Disconnect -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_scan_ble"
                        style="@style/Widget.MaterialComponents.Button"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:text="@string/waterbottle_scan"
                        android:textAllCaps="false"
                        android:textColor="@color/text_white"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:backgroundTint="@color/teal_primary"
                        app:cornerRadius="12dp"
                        app:icon="@drawable/ic_bluetooth"
                        app:iconGravity="textStart"
                        app:iconTint="@color/text_white" />

                    <!-- Scanning Progress Spinner inside the button row -->
                    <ProgressBar
                        android:id="@+id/pb_scanning"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="end|center_vertical"
                        android:layout_marginEnd="16dp"
                        android:elevation="4dp"
                        android:indeterminate="true"
                        android:indeterminateTint="@color/text_white"
                        android:visibility="gone"
                        tools:visibility="visible" />
                </FrameLayout>

                <!-- Discovered Bottles Section (Hidden when bottle is connected) -->
                <LinearLayout
                    android:id="@+id/layout_discovered_section"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Discovered Bottles Header -->
                    <TextView
                        android:id="@+id/tv_discovered_header"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="8dp"
                        android:text="Discovered Bottles"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <!-- Empty State View -->
                    <LinearLayout
                        android:id="@+id/layout_empty_devices"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp"
                        android:background="@drawable/bg_metric_tile">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_bluetooth"
                            app:tint="@color/text_hint" />

                        <TextView
                            android:id="@+id/tv_empty_devices_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:text="@string/waterbottle_no_devices"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Discovered Devices RecyclerView -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_discovered_devices"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        android:visibility="gone"
                        tools:visibility="visible"
                        tools:listitem="@layout/item_ble_device" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
