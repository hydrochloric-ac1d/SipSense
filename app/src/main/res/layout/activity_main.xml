<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_main.xml

    Layout for the main post-login screen (MainActivity).
    Uses a FrameLayout as a fragment container to host the four
    top-level destinations (Dashboard, History, Devices, Profile),
    with a BottomNavigationView pinned to the bottom of the screen.

    Structure:
    ┌──────────────────────────────────┐
    │  [Logo SipSense]  [WiFi Status] │  ← Header Bar
    ├──────────────────────────────────┤
    │                                  │
    │       Fragment Container         │
    │    (swapped by navigation)       │
    │                                  │
    ├──────────────────────────────────┤
    │  BottomNavigationView            │
    │  [Dashboard][History][Devices]   │
    │            [Profile]             │
    └──────────────────────────────────┘

    @project SipSense - Smart Bottle Ecosystem
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@drawable/bg_gradient_teal">

    <!-- ════════════════════════════════════════════════════════════════
         HEADER BAR
         Always-visible top bar containing:
         - Left side: SipSense logo + app name
         - Right side: WiFi connection status badge (dark teal card)
         Constrained to the top of the screen with horizontal padding.
         ════════════════════════════════════════════════════════════════ -->
    <LinearLayout
        android:id="@+id/header_bar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/spacing_lg"
        android:paddingEnd="@dimen/spacing_lg"
        android:paddingTop="8dp"
        android:paddingBottom="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- ── LEFT SIDE: SipSense Logo (5-tap secret developer unlock) ── -->
        <ImageView
            android:id="@+id/iv_header_logo"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/logo_sipsense_white"
            android:contentDescription="@string/app_name"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/tv_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="@string/header_title"
            android:textColor="@color/text_white"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.02" />

        <!-- Spacer pushes status badge to the right -->
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- ── RIGHT SIDE: WiFi / BLE Status Badge ─────────────────────── -->
        <LinearLayout
            android:id="@+id/wifi_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_wifi_status_badge"
            android:paddingStart="@dimen/spacing_md"
            android:paddingEnd="@dimen/spacing_md"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <!-- Bluetooth status icon -->
            <ImageView
                android:id="@+id/iv_wifi_icon"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_bluetooth"
                android:contentDescription="@string/wifi_disconnected"
                app:tint="@color/nav_unselected"
                android:scaleType="fitCenter" />

            <!-- Connection status label -->
            <TextView
                android:id="@+id/tv_wifi_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/spacing_xs"
                android:text="@string/wifi_disconnected"
                android:textColor="@color/nav_unselected"
                android:textSize="@dimen/text_badge"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

        </LinearLayout>

    </LinearLayout>

    <!-- ════════════════════════════════════════════════════════════════
         FRAGMENT CONTAINER
         Hosts the currently active fragment (Dashboard, History,
         Devices, or Profile). Fills space between header and floating nav bar.
         ════════════════════════════════════════════════════════════════ -->
    <FrameLayout
        android:id="@+id/fragment_container"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/header_bar"
        app:layout_constraintBottom_toTopOf="@id/card_bottom_navigation"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- ════════════════════════════════════════════════════════════════
         FLOATING BOTTOM NAVIGATION BAR
         Floating pill bar with spaces on each side and smooth rounded corners.
         ════════════════════════════════════════════════════════════════ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_bottom_navigation"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="12dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/card_background"
        app:contentPaddingLeft="12dp"
        app:contentPaddingRight="12dp"
        app:contentPaddingTop="0dp"
        app:contentPaddingBottom="0dp"
        app:strokeWidth="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottom_navigation"
            style="@style/Widget.MaterialComponents.BottomNavigationView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:minHeight="0dp"
            app:elevation="0dp"
            app:itemActiveIndicatorStyle="@null"
            app:itemIconSize="22dp"
            app:itemIconTint="@color/nav_item_color"
            app:itemPaddingBottom="6dp"
            app:itemPaddingTop="14dp"
            app:itemTextAppearanceActive="@style/SipSense.BottomNav.Text"
            app:itemTextAppearanceInactive="@style/SipSense.BottomNav.Text"
            app:itemTextColor="@color/nav_item_color"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/bottom_nav_menu" />

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
