<?xml version="1.0" encoding="utf-8"?>
<!--
    bottom_nav_menu.xml

    Menu resource defining the items displayed in the bottom navigation bar.
    Each item corresponds to a top-level destination in the app:
    - Dashboard: Home screen with hydration overview
    - History: Hydration tracking history / logs
    - Devices: Connected IoT bottle device management
    - Notifications: Hydration reminders and device alerts
    - Profile: User account and settings

    Icons are PNG assets located in res/drawable/.

    @project SipSense - Smart Bottle Ecosystem
-->
<menu xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:id="@+id/nav_dashboard"
        android:icon="@drawable/droplet"
        android:title="@string/nav_dashboard" />

    <item
        android:id="@+id/nav_history"
        android:icon="@drawable/calendar"
        android:title="@string/nav_history" />

    <item
        android:id="@+id/nav_devices"
        android:icon="@drawable/water_bottle"
        android:title="@string/nav_devices" />

    <item
        android:id="@+id/nav_notifications"
        android:icon="@drawable/ic_bell"
        android:title="@string/nav_notifications" />

    <item
        android:id="@+id/nav_profile"
        android:icon="@drawable/user"
        android:title="@string/nav_profile" />

</menu>
