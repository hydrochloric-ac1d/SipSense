<?xml version="1.0" encoding="utf-8"?>
<!--
    AndroidManifest.xml

    Application manifest for the SipSense Android app.
    Declares the application's activities and their configurations:

    - LoginActivity: The launcher activity (entry point of the app).
      Displayed when the user opens SipSense from the home screen.

    - RegisterActivity: The registration screen.
      Navigated to from LoginActivity when the user taps "Sign Up".

    Both activities use the SipSense custom theme (Theme.SipSense)
    which removes the default action bar and applies brand styling.

    @project SipSense - Smart Bottle Ecosystem
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.sipsense.app"
    android:versionCode="1"
    android:versionName="1.0.0" >

    <uses-sdk
        android:minSdkVersion="26"
        android:targetSdkVersion="35" />

    <permission
        android:name="com.sipsense.app.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.sipsense.app.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@drawable/logo_sipsense"
        android:label="@string/app_name"
        android:roundIcon="@drawable/logo_sipsense"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/Theme.SipSense" >

        <!--
            LoginActivity - Main entry point
            IntentFilter with MAIN action and LAUNCHER category marks
            this as the first screen shown when the app is launched.
        -->
        <activity
            android:name="com.sipsense.app.LoginActivity"
            android:exported="true"
            android:screenOrientation="portrait" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            RegisterActivity - User registration screen
            Not exported (only accessible within the app).
            Locked to portrait orientation for consistent form layout.
        -->
        <activity
            android:name="com.sipsense.app.RegisterActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.sipsense.app.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>