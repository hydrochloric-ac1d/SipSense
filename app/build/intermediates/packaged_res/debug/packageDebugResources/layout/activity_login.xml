<?xml version="1.0" encoding="utf-8"?>
<!--
    activity_login.xml

    Login screen layout for the SipSense application.
    ══════════════════════════════════════════════════════════════════════

    LAYOUT STRUCTURE (ConstraintLayout hierarchy):
    ┌─ Root ConstraintLayout (teal gradient background)
    │  └─ ScrollView (fills screen, handles small devices)
    │     └─ Inner ConstraintLayout (content wrapper)
    │        ├─ ImageView: SipSense logo (centered, top)
    │        ├─ TextView: "SipSense" app name
    │        ├─ TextView: "IoT Sync" badge
    │        ├─ TextView: "Track. Hydrate. Feel Great." tagline
    │        ├─ ConstraintLayout: White rounded card
    │        │  ├─ LinearLayout: Tab toggle (Log In | Sign Up)
    │        │  ├─ TextView + TextInputLayout: Email field
    │        │  ├─ TextView + TextInputLayout: Password field
    │        │  ├─ CheckBox: Remember me
    │        │  ├─ TextView: Forgot Password? link
    │        │  ├─ Button: Log In (gradient)
    │        │  └─ TextView: Sign up prompt
    │        └─ TextView: Footer copyright
    └──────────────────────────────────────────────────────────────────

    DESIGN NOTES:
    - Uses ConstraintLayout as the primary layout manager (per requirements)
    - LinearLayout used only for the tab row (weighted distribution)
    - TextInputLayout from Material Components for styled input fields
    - Gradient button uses a custom drawable background

    @project SipSense - Smart Bottle Ecosystem
    @screen Login Screen
    @see LoginActivity.kt
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_teal"
    tools:context=".LoginActivity">

    <!-- ════════════════════════════════════════════════════════════════
         SCROLLABLE CONTENT WRAPPER
         ScrollView ensures the layout remains accessible on smaller
         screens or when the keyboard is displayed.
         fillViewport="true" stretches content to fill the screen.
         ════════════════════════════════════════════════════════════════ -->
    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        android:overScrollMode="never"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Inner content ConstraintLayout -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/spacing_lg">

            <!-- ══════════════════════════════════════════════════════
                 BRANDING HEADER SECTION
                 Logo, app name, IoT Sync badge, and tagline
                 displayed above the login card on the gradient bg.
                 ══════════════════════════════════════════════════════ -->

            <!-- SipSense Logo Image -->
            <ImageView
                android:id="@+id/ivLogo"
                android:layout_width="@dimen/logo_size"
                android:layout_height="@dimen/logo_size"
                android:src="@drawable/logo_sipsense"
                android:contentDescription="@string/app_name"
                android:scaleType="centerInside"
                android:background="@drawable/bg_logo_container"
                android:padding="@dimen/logo_padding"
                android:layout_marginTop="@dimen/logo_margin_top"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- App Name "SipSense" - Chained with IoT Badge -->
            <TextView
                android:id="@+id/tvAppName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/text_white"
                android:textSize="@dimen/text_app_name"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:layout_marginTop="@dimen/spacing_md"
                app:layout_constraintTop_toBottomOf="@id/ivLogo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/tvIotBadge"
                app:layout_constraintHorizontal_chainStyle="packed" />

            <!-- "IoT Sync" Badge - Small teal rounded label -->
            <TextView
                android:id="@+id/tvIotBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/iot_sync"
                android:textColor="@color/text_white"
                android:textSize="@dimen/text_badge"
                android:textStyle="bold"
                android:background="@drawable/bg_iot_badge"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:layout_marginStart="@dimen/spacing_sm"
                app:layout_constraintStart_toEndOf="@id/tvAppName"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/tvAppName"
                app:layout_constraintBottom_toBottomOf="@id/tvAppName" />

            <!-- Tagline "Track. Hydrate. Feel Great." -->
            <TextView
                android:id="@+id/tvTagline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tagline"
                android:textColor="@color/text_white"
                android:textSize="@dimen/text_tagline"
                android:alpha="0.9"
                android:layout_marginTop="@dimen/spacing_xs"
                app:layout_constraintTop_toBottomOf="@id/tvAppName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- ══════════════════════════════════════════════════════
                 LOGIN CARD
                 White rounded container holding the login form.
                 Uses a nested ConstraintLayout for precise positioning
                 of all form elements within the card.
                 ══════════════════════════════════════════════════════ -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cardLogin"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_rounded"
                android:layout_marginTop="@dimen/spacing_xxl"
                android:layout_marginStart="@dimen/card_margin_horizontal"
                android:layout_marginEnd="@dimen/card_margin_horizontal"
                android:paddingStart="@dimen/card_padding_horizontal"
                android:paddingEnd="@dimen/card_padding_horizontal"
                android:paddingTop="@dimen/card_padding_top"
                android:paddingBottom="@dimen/card_padding_bottom"
                android:elevation="@dimen/card_elevation"
                app:layout_constraintTop_toBottomOf="@id/tvTagline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- ──────────────────────────────────────────────────
                     TAB TOGGLE ROW
                     Pill-shaped container with two equally-weighted
                     tabs: "Log In" (active) and "Sign Up" (inactive).
                     LinearLayout used here for equal weight distribution.
                     ────────────────────────────────────────────────── -->
                <LinearLayout
                    android:id="@+id/tabContainer"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/height_tab_row"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_tab_container"
                    android:padding="@dimen/spacing_xs"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- Log In Tab (Active State) -->
                    <TextView
                        android:id="@+id/tabLogin"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/tab_login"
                        android:textColor="@color/teal_primary"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_body"
                        android:gravity="center"
                        android:background="@drawable/bg_tab_selected"
                        android:drawablePadding="6dp" />

                    <!-- Sign Up Tab (Inactive State) -->
                    <TextView
                        android:id="@+id/tabSignUp"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/tab_signup"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_body"
                        android:gravity="center"
                        android:background="@android:color/transparent"
                        android:drawablePadding="6dp" />

                </LinearLayout>

                <!-- ──────────────────────────────────────────────────
                     EMAIL ADDRESS FIELD
                     ────────────────────────────────────────────────── -->

                <!-- Label above email input -->
                <TextView
                    android:id="@+id/tvEmailLabel"
                    style="@style/SipSense.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_email"
                    android:layout_marginTop="@dimen/spacing_xxl"
                    app:layout_constraintTop_toBottomOf="@id/tabContainer"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Email TextInputLayout with envelope start icon -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEmail"
                    style="@style/SipSense.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    app:startIconDrawable="@drawable/ic_email"
                    app:startIconTint="@color/text_hint"
                    app:layout_constraintTop_toBottomOf="@id/tvEmailLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_email"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textSize="@dimen/text_body"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:gravity="center_vertical"
                        android:singleLine="true" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- ──────────────────────────────────────────────────
                     PASSWORD FIELD
                     ────────────────────────────────────────────────── -->

                <!-- Label above password input -->
                <TextView
                    android:id="@+id/tvPasswordLabel"
                    style="@style/SipSense.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_password"
                    android:layout_marginTop="@dimen/spacing_lg"
                    app:layout_constraintTop_toBottomOf="@id/tilEmail"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Password TextInputLayout with lock icon and visibility toggle -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPassword"
                    style="@style/SipSense.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_sm"
                    app:startIconDrawable="@drawable/ic_lock"
                    app:startIconTint="@color/text_hint"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/text_hint"
                    app:layout_constraintTop_toBottomOf="@id/tvPasswordLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_password"
                        android:inputType="textPassword"
                        android:textColor="@color/text_primary"
                        android:textColorHint="@color/text_hint"
                        android:textSize="@dimen/text_body"
                        android:paddingTop="16dp"
                        android:paddingBottom="16dp"
                        android:gravity="center_vertical"
                        android:singleLine="true" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- ──────────────────────────────────────────────────
                     REMEMBER ME / FORGOT PASSWORD ROW
                     Checkbox on the left, clickable link on the right.
                     ────────────────────────────────────────────────── -->

                <!-- "Remember me" Checkbox -->
                <CheckBox
                    android:id="@+id/cbRememberMe"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/remember_me"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:buttonTint="@color/teal_primary"
                    android:layout_marginTop="@dimen/spacing_md"
                    app:layout_constraintTop_toBottomOf="@id/tilPassword"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- "Forgot Password?" Clickable Link -->
                <TextView
                    android:id="@+id/tvForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/forgot_password"
                    android:textColor="@color/teal_primary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="@id/cbRememberMe"
                    app:layout_constraintBottom_toBottomOf="@id/cbRememberMe"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- ──────────────────────────────────────────────────
                     PRIMARY ACTION BUTTON
                     Gradient teal-to-blue "Log In →" button.
                     ────────────────────────────────────────────────── -->
                <Button
                    android:id="@+id/btnLogin"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/height_button"
                    android:text="@string/btn_login"
                    android:textColor="@color/text_white"
                    android:textSize="@dimen/text_heading"
                    android:textStyle="bold"
                    android:textAllCaps="false"
                    android:background="@drawable/bg_button_gradient"
                    android:stateListAnimator="@null"
                    android:elevation="4dp"
                    android:layout_marginTop="@dimen/spacing_xl"
                    app:layout_constraintTop_toBottomOf="@id/cbRememberMe"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- ──────────────────────────────────────────────────
                     SIGN UP NAVIGATION PROMPT
                     "Don't have an account? Sign up now"
                     Clickable link text set programmatically.
                     ────────────────────────────────────────────────── -->
                <TextView
                    android:id="@+id/tvSignUpPrompt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="@dimen/spacing_lg"
                    android:layout_marginBottom="@dimen/spacing_sm"
                    app:layout_constraintTop_toBottomOf="@id/btnLogin"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
            <!-- End of Login Card -->

            <!-- ══════════════════════════════════════════════════════
                 FOOTER COPYRIGHT
                 ══════════════════════════════════════════════════════ -->
            <TextView
                android:id="@+id/tvFooter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/footer_text"
                android:textColor="@color/text_white"
                android:textSize="@dimen/text_caption"
                android:alpha="0.7"
                android:gravity="center"
                android:layout_marginTop="@dimen/spacing_xl"
                android:paddingHorizontal="@dimen/spacing_xxxl"
                app:layout_constraintTop_toBottomOf="@id/cardLogin"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
        <!-- End of inner content -->

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
