<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_password_strength_segment.xml

    Individual segment shape for the 4-part password strength indicator
    on the registration screen. Each segment is a small rounded rectangle
    that starts grey (inactive) and changes color programmatically as
    password criteria are met.

    Color progression (set in RegisterActivity.kt):
    - 0/4 met: all grey (#D0D8DA)
    - 1/4 met: 1 red (#E74C3C)
    - 2/4 met: 2 orange (#F39C12)
    - 3/4 met: 3 teal (#2BB5B2)
    - 4/4 met: 4 green (#27AE60)

    Usage: android:background="@drawable/bg_password_strength_segment"
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Default inactive grey color (changed via backgroundTintList in code) -->
    <solid android:color="@color/strength_inactive" />

    <!-- Small rounded ends for a polished look -->
    <corners android:radius="@dimen/radius_strength" />

</shape>
