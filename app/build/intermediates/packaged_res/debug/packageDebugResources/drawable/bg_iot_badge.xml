<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_iot_badge.xml

    Small teal rounded badge background for the "IoT Sync" label
    displayed next to the "SipSense" app name on the login screen.

    Creates a compact, pill-shaped badge with a semi-transparent
    teal fill to indicate IoT connectivity status.

    Usage: android:background="@drawable/bg_iot_badge"
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Semi-transparent teal background -->
    <solid android:color="#50FFFFFF" />

    <!-- Small rounded corners for badge appearance -->
    <corners android:radius="@dimen/radius_badge" />

    <!-- Subtle border for definition -->
    <stroke
        android:width="1dp"
        android:color="#60FFFFFF" />

</shape>
