<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_button_gradient.xml

    Gradient background for primary action buttons (Login, Create Account).
    Horizontal gradient from teal (#2BB5B2) on the left to blue (#3B7DD8)
    on the right, matching the vibrant button style in the reference designs.

    The rounded corners (28dp) create a pill-shaped button appearance.

    Usage: android:background="@drawable/bg_button_gradient"
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Horizontal teal-to-blue gradient -->
    <gradient
        android:startColor="@color/button_gradient_start"
        android:endColor="@color/button_gradient_end"
        android:angle="0"
        android:type="linear" />

    <!-- Pill-shaped rounded corners -->
    <corners android:radius="@dimen/radius_button" />

</shape>
