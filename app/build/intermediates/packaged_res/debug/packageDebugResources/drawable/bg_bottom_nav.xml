<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_bottom_nav.xml

    Background drawable for the bottom navigation bar.
    White rectangle with rounded top-left and top-right corners (24dp)
    matching the card login radius (radius_card). Bottom corners remain
    square to sit flush against the screen edge.

    Usage: android:background="@drawable/bg_bottom_nav"

    @project SipSense - Smart Bottle Ecosystem
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Solid white navigation bar surface -->
    <solid android:color="@color/card_background" />

    <!-- Rounded corners on all four sides (matching card radius) -->
    <corners android:radius="@dimen/radius_card" />

</shape>
