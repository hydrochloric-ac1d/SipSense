<?xml version="1.0" encoding="utf-8"?>
<!--
    bg_logo_container.xml

    Rounded square container behind the SipSense logo on the login screen.
    Uses a semi-transparent white fill to create a frosted glass effect
    that makes the logo stand out against the teal gradient background.

    Usage: android:background="@drawable/bg_logo_container"
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Semi-transparent white for frosted glass look -->
    <solid android:color="#FFFFFF" />

    <!-- Rounded corners for modern card aesthetic -->
    <corners android:radius="@dimen/radius_logo" />

</shape>
